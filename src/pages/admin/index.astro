---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../lib/supabase';
import { requireAdmin, formatearFecha } from '../../lib/adminAuth';

const { user, redirect } = await requireAdmin(Astro);
if (redirect) return redirect;

const { count: mensajesCount } = await supabase
  .from('contacto_mensajes')
  .select('*', { count: 'exact', head: true });

const { data: mensajes } = await supabase
  .from('contacto_mensajes')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(5);

const { count: contenidosCount } = await supabase
  .from('contenidos')
  .select('*', { count: 'exact', head: true });
---

<AdminLayout
  title="Panel principal"
  subtitle={`Resumen de ${new Date().toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}`}
  email={user.email ?? ''}
>
  <div class="stats">
    <div class="stat-card">
      <div class="stat-card__icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      </div>
      <p class="stat-card__label">Mensajes recibidos</p>
      <p class="stat-card__value">{mensajesCount ?? 0}</p>
    </div>

    <div class="stat-card">
      <div class="stat-card__icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      </div>
      <p class="stat-card__label">Textos editados</p>
      <p class="stat-card__value">{contenidosCount ?? 0}</p>
    </div>
  </div>

  <div class="panel">
    <div class="panel__header">
      <h2>Últimos mensajes</h2>
      <a href="/admin/mensajes"><span class="panel__badge">Ver todos</span></a>
    </div>
    {mensajes && mensajes.length > 0 ? (
      mensajes.map((m: any) => (
        <article class="mensaje">
          <div class="mensaje__cabecera">
            <span class="mensaje__nombre">{m.nombre}</span>
            <time class="mensaje__fecha" datetime={m.created_at}>{formatearFecha(m.created_at)}</time>
          </div>
          <p class="mensaje__email">{m.email}</p>
          {m.asunto && <p class="mensaje__asunto">{m.asunto}</p>}
          <p class="mensaje__texto">{m.mensaje}</p>
        </article>
      ))
    ) : (
      <p class="vacio">Todavía no ha llegado ningún mensaje</p>
    )}
  </div>
</AdminLayout>

<style>
  .mensaje {
    padding: var(--space-3);
    border-bottom: 1px solid var(--color-border-light);
  }

  .mensaje:last-child {
    border-bottom: none;
  }

  .mensaje__cabecera {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-1);
  }

  .mensaje__nombre {
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
  }

  .mensaje__fecha {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .mensaje__email {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .mensaje__asunto {
    font-size: var(--text-sm);
    color: var(--color-primary-dark);
    font-weight: var(--weight-medium);
    margin-bottom: var(--space-1);
  }

  .mensaje__texto {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
</style>
