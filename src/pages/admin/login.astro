---
export const prerender = false;

import { supabase } from '../../lib/supabase';
import { clinica } from '../../config/clinica';
import '../../styles/global.css';

const { cookies, redirect } = Astro;

// Si ya hay sesión, directo al panel
const token = cookies.get('sb-access-token')?.value;
const refresh = cookies.get('sb-refresh-token')?.value;

if (token && refresh) {
  const { data } = await supabase.auth.setSession({ access_token: token, refresh_token: refresh });
  if (data.session) {
    return redirect('/admin');
  }
}

let mensajeError = '';

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const email = datos.get('email') as string;
  const password = datos.get('password') as string;

  const { data, error } = await supabase.auth.signInWithPassword({ email, password });

  if (error) {
    mensajeError = 'El correo o la contraseña no son correctos.';
  } else if (data.session) {
    cookies.set('sb-access-token', data.session.access_token, {
      path: '/',
      httpOnly: true,
      secure: true,
      sameSite: 'lax',
      maxAge: 60 * 60,
    });
    cookies.set('sb-refresh-token', data.session.refresh_token, {
      path: '/',
      httpOnly: true,
      secure: true,
      sameSite: 'lax',
      maxAge: 60 * 60 * 24 * 7,
    });
    return redirect('/admin');
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <title>Entrar al panel | {clinica.nombre}</title>
  </head>
  <body>
    <main class="login">
      <div class="login__card">
        <div class="login__cabecera">
          <img src="/logo.png" alt={clinica.nombre} width="500" height="417" />
          <h1>Panel de administración</h1>
          <p>Entra para gestionar los mensajes y los textos de la web</p>
        </div>

        {mensajeError && (
          <p class="login__error" role="alert">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/></svg>
            {mensajeError}
          </p>
        )}

        <form method="POST" class="login__form">
          <div class="form-field">
            <label for="email">Correo</label>
            <input type="email" id="email" name="email" autocomplete="username" required autofocus />
          </div>

          <div class="form-field">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required />
          </div>

          <button type="submit" class="btn btn--primary login__submit">
            Entrar
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
          </button>
        </form>

        <a href="/" class="login__volver">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Volver a la web
        </a>
      </div>
    </main>
  </body>
</html>

<style>
  .login {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    background: radial-gradient(ellipse 50% 40% at 50% 0%, rgba(231, 127, 74, 0.10) 0%, transparent 70%);
  }

  .login__card {
    width: 100%;
    max-width: 400px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius);
    padding: var(--space-5);
    box-shadow: var(--shadow-lg);
  }

  .login__cabecera {
    text-align: center;
    margin-bottom: var(--space-4);
  }

  .login__cabecera img {
    width: auto;
    height: 72px;
    margin: 0 auto var(--space-3);
    mix-blend-mode: multiply;
  }

  .login__cabecera h1 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-1);
  }

  .login__cabecera p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .login__error {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    margin-bottom: var(--space-3);
    background: var(--color-error-soft);
    color: var(--color-error);
    border-radius: var(--radius);
    font-size: var(--text-sm);
  }

  .login__error svg {
    flex-shrink: 0;
  }

  .login__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .login__submit {
    width: 100%;
    margin-top: var(--space-1);
  }

  .login__volver {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .login__volver:hover {
    color: var(--color-primary-dark);
  }
</style>
