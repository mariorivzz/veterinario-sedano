---
import { clinica, telefonoEnlace } from '../config/clinica';

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
const tel = telefonoEnlace();
---

<a href="#contenido" class="skip-link">Saltar al contenido</a>

<header class="header" id="header">
  <div class="header__inner">
    <a href="/" class="header__logo" aria-label={`${clinica.nombre} — ir al inicio`}>
      <img src="/logo.png" alt={clinica.nombre} width="500" height="417" />
    </a>

    <nav class="header__nav" id="nav" aria-label="Navegación principal">
      <ul class="header__links">
        {navLinks.map(link => (
          <li>
            <a href={link.href} class:list={['header__link', { active: currentPath === link.href }]}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a href={tel ?? '/contacto'} class="header__cta">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        Llámanos
      </a>
    </nav>

    <button class="header__hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  const hamburger = document.getElementById('hamburger');
  const nav = document.getElementById('nav');
  const header = document.getElementById('header');

  function cerrarMenu() {
    nav?.classList.remove('is-open');
    hamburger?.classList.remove('is-open');
    header?.classList.remove('nav-abierto');
    hamburger?.setAttribute('aria-expanded', 'false');
    hamburger?.setAttribute('aria-label', 'Abrir menú');
    document.body.style.removeProperty('overflow');
  }

  hamburger?.addEventListener('click', () => {
    const abierto = nav?.classList.toggle('is-open') ?? false;
    hamburger.classList.toggle('is-open', abierto);
    // El desenfoque de la cabecera crea un bloque contenedor que rompería
    // el position:fixed del panel, así que lo quitamos mientras está abierto
    header?.classList.toggle('nav-abierto', abierto);
    hamburger.setAttribute('aria-expanded', String(abierto));
    hamburger.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
    document.body.style.overflow = abierto ? 'hidden' : '';
  });

  // Cerrar al pulsar un enlace o Escape, para que el menú no se quede abierto
  nav?.querySelectorAll('a').forEach(enlace => enlace.addEventListener('click', cerrarMenu));

  document.addEventListener('keydown', (evento) => {
    if (evento.key === 'Escape' && nav?.classList.contains('is-open')) {
      cerrarMenu();
      hamburger?.focus();
    }
  });

  window.addEventListener('scroll', () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 24);
  }, { passive: true });
</script>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
    z-index: 1100;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    background: var(--color-primary);
    color: #fff;
    border-radius: var(--radius);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    transform: translateY(-200%);
    transition: transform var(--transition-fast);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(253, 251, 248, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .header.is-scrolled {
    border-bottom-color: var(--color-border-light);
    box-shadow: var(--shadow-sm);
  }

  /* Con el menú abierto, la cabecera es opaca y sin desenfoque:
     así el panel de navegación se posiciona contra la ventana */
  .header.nav-abierto {
    background: var(--color-background);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .header__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-2) var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 84px;
  }

  .header__logo {
    display: flex;
    align-items: center;
    min-height: 44px;
    flex-shrink: 0;
  }

  .header__logo img {
    width: auto;
    height: 64px;
    /* El logotipo trae fondo blanco: así se funde con el fondo cálido */
    mix-blend-mode: multiply;
  }

  @media (max-width: 480px) {
    .header__logo img {
      height: 52px;
    }
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .header__links {
    list-style: none;
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
  }

  .header__link {
    display: block;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    border-radius: var(--radius);
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .header__link:hover {
    color: var(--color-text);
    background: var(--color-primary-tint);
  }

  .header__link.active {
    color: var(--color-primary-dark);
    background: var(--color-primary-tint);
  }

  .header__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    min-height: 44px;
    background: var(--color-primary);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-round);
    transition: background var(--transition-fast), transform var(--transition-fast);
  }

  .header__cta:hover {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
  }

  .header__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    width: 44px;
    height: 44px;
    padding: var(--space-2);
    background: none;
    border: none;
  }

  .header__hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: var(--radius-round);
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .header__hamburger.is-open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__hamburger.is-open span:nth-child(2) {
    opacity: 0;
  }

  .header__hamburger.is-open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .header__hamburger {
      display: flex;
    }

    .header__nav {
      position: fixed;
      inset: 84px 0 0;
      background: var(--color-background);
      flex-direction: column;
      justify-content: flex-start;
      align-items: stretch;
      padding: var(--space-4);
      gap: var(--space-4);
      overflow-y: auto;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition: opacity var(--transition-base), transform var(--transition-base);
    }

    .header__nav.is-open {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .header__links {
      flex-direction: column;
      gap: var(--space-1);
    }

    .header__link {
      font-size: var(--text-lg);
      padding: var(--space-3);
    }

    .header__cta {
      justify-content: center;
      padding: var(--space-3) var(--space-4);
      font-size: var(--text-base);
    }
  }
</style>
