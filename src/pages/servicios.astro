---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
---

<Layout title="Servicios">
  <section class="page-hero">
    <div class="container">
      <span class="badge reveal">Nuestros servicios</span>
      <h1 class="reveal">Todo lo que tu mascota necesita</h1>
      <p class="reveal">Atención veterinaria completa con equipos modernos y profesionales dedicados</p>
    </div>
  </section>

  <section class="services section">
    <div class="container">
      <div class="services__grid">
        <div class="reveal"><ServiceCard icon="syringe" title="Vacunación" description="Programa completo de vacunación para cachorros y adultos. Protege a tu mascota de las principales enfermedades infecciosas." /></div>
        <div class="reveal"><ServiceCard icon="stethoscope" title="Consulta General" description="Exámenes de rutina, diagnóstico y tratamiento de enfermedades. Planes de salud personalizados." /></div>
        <div class="reveal"><ServiceCard icon="tooth" title="Odontología" description="Limpieza dental profesional, extracciones y tratamientos periodontales para una higiene oral perfecta." /></div>
        <div class="reveal"><ServiceCard icon="scissors" title="Peluquería" description="Baño, corte, deslanado y tratamientos estéticos adaptados a las necesidades de cada raza." /></div>
        <div class="reveal"><ServiceCard icon="microscope" title="Laboratorio" description="Análisis de sangre, orina y estudios especializados con resultados rápidos y precisos." /></div>
        <div class="reveal"><ServiceCard icon="hospital" title="Cirugía" description="Procedimientos quirúrgicos con equipos de última generación y anestesia segura monitorizada." /></div>
        <div class="reveal"><ServiceCard icon="pill" title="Farmacia" description="Amplio stock de medicamentos veterinarios y productos de cuidado animal de primeras marcas." /></div>
        <div class="reveal"><ServiceCard icon="ambulance" title="Urgencias 24h" description="Atención de emergencias las 24 horas del día, los 365 días del año. Siempre disponibles." /></div>
      </div>
    </div>
  </section>

  <section class="cta-banner reveal">
    <div class="container">
      <div class="cta-banner__inner">
        <div class="cta-banner__text">
          <h2>¿Necesitas una consulta?</h2>
          <p>Reserva tu cita online de forma rápida y sencilla.</p>
        </div>
        <a href="/citas" class="btn btn--white">
          Agendar cita
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: var(--space-4xl) 0 var(--space-3xl);
    text-align: center;
    background:
      radial-gradient(ellipse 60% 50% at 50% 0%, rgba(45, 106, 79, 0.06) 0%, transparent 70%);
  }

  .page-hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .page-hero p {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    max-width: 520px;
    margin: 0 auto;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-lg);
  }

  .cta-banner {
    padding: 0 0 var(--space-3xl);
  }

  .cta-banner__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl) var(--space-3xl);
    color: #fff;
  }

  .cta-banner h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: var(--space-xs);
    letter-spacing: -0.02em;
  }

  .cta-banner p {
    opacity: 0.9;
  }

  .btn--white {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.75rem 1.75rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    border: 2px solid #fff;
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .btn--white:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  @media (max-width: 768px) {
    .cta-banner__inner {
      flex-direction: column;
      text-align: center;
      padding: var(--space-2xl);
    }
  }
</style>
