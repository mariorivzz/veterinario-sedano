---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Dato from '../components/Dato.astro';
import { supabase } from '../lib/supabase';
import { clinica, telefonoEnlace } from '../config/clinica';

// Textos editables desde el panel de administración
const { data: rows } = await supabase.from('contenidos').select('clave, valor');
const c: Record<string, string> = {};
if (rows) {
  for (const row of rows) {
    c[row.clave] = row.valor;
  }
}

// Devuelve el texto editado, o el que viene por defecto
const t = (key: string, fallback: string) => c[key] ?? fallback;

const tel = telefonoEnlace();
---

<Layout title="Inicio">
  <!-- Portada -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <div class="hero__gradient"></div>
      <div class="hero__dots"></div>
    </div>
    <div class="hero__inner container">
      <div class="hero__content">
        <span class="badge reveal">{t('hero_badge', 'Clínica veterinaria')}</span>
        <h1 class="hero__title reveal">{t('hero_titulo', 'Cuidamos a tu mascota como si fuera nuestra')}</h1>
        <p class="hero__subtitle reveal">
          {t('hero_subtitulo', 'Revisiones, vacunas, análisis y cirugía en Salamanca. Te explicamos siempre qué le pasa a tu animal y qué vamos a hacer, sin palabras raras.')}
        </p>
        <div class="hero__actions reveal">
          <a href={tel ?? '/contacto'} class="btn btn--primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            Llámanos
          </a>
          <a href="/servicios" class="btn btn--secondary">Ver servicios</a>
        </div>
      </div>

      <!-- Horario: lo primero que busca cualquiera que entra -->
      <div class="hero__visual reveal">
        <div class="hero__panel">
          <h2 class="hero__panel-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Cuándo estamos
          </h2>
          <ul class="hero__horario">
            <li><Dato dato={clinica.horario.semana} /></li>
            <li><Dato dato={clinica.horario.sabado} /></li>
            <li><Dato dato={clinica.horario.domingo} /></li>
          </ul>
          <a class="hero__mapa" href={clinica.mapa} target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <Dato dato={clinica.direccion} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="services section">
    <div class="container">
      <div class="section-header reveal">
        <span class="badge">{t('servicios_badge', 'Lo que hacemos')}</span>
        <h2>{t('servicios_titulo', 'Nuestros servicios')}</h2>
        <p>{t('servicios_subtitulo', 'Todo lo que tu mascota necesita, en un mismo sitio')}</p>
      </div>
      <div class="services__grid">
        <div class="reveal">
          <ServiceCard
            icon="syringe"
            title="Vacunación"
            description="Le ponemos las vacunas que le tocan y llevamos la cuenta para que no se te pase ninguna."
          />
        </div>
        <div class="reveal">
          <ServiceCard
            icon="stethoscope"
            title="Consulta general"
            description="Revisamos a tu mascota de arriba abajo y te contamos cómo está en palabras que se entienden."
          />
        </div>
        <div class="reveal">
          <ServiceCard
            icon="tooth"
            title="Odontología"
            description="Limpiezas de boca y extracciones. Los dientes en mal estado duelen más de lo que parece."
          />
        </div>
        <div class="reveal">
          <ServiceCard
            icon="scissors"
            title="Peluquería"
            description="Baño, corte y cepillado, adaptados al pelo de cada animal."
          />
        </div>
      </div>
      <div class="services__cta reveal">
        <a href="/servicios" class="btn btn--outline">
          Ver todos los servicios
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Por qué nosotros -->
  <section class="why section">
    <div class="container">
      <div class="section-header reveal">
        <span class="badge">{t('why_badge', 'Por qué elegirnos')}</span>
        <h2>{t('why_titulo', 'Para nosotros, tu mascota es de la familia')}</h2>
      </div>
      <div class="why__grid">
        <div class="why__card reveal">
          <div class="why__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h3>{t('why_1_titulo', 'Veterinarios colegiados')}</h3>
          <p>{t('why_1_desc', 'Todo el equipo está colegiado y se sigue formando cada año.')}</p>
        </div>
        <div class="why__card reveal">
          <div class="why__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg>
          </div>
          <h3>{t('why_2_titulo', 'Te lo explicamos claro')}</h3>
          <p>{t('why_2_desc', 'Antes de hacer nada te contamos qué le pasa, qué cuesta y qué opciones hay.')}</p>
        </div>
        <div class="why__card reveal">
          <div class="why__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
          </div>
          <h3>{t('why_3_titulo', 'Con calma y con mimo')}</h3>
          <p>{t('why_3_desc', 'Vamos al ritmo del animal para que la visita le asuste lo menos posible.')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Llamada final -->
  <section class="cta reveal">
    <div class="container">
      <div class="cta__inner">
        <h2>{t('cta_titulo', '¿Tu mascota necesita que la veamos?')}</h2>
        <p>{t('cta_subtitulo', 'Llámanos y te decimos cuándo podemos atenderla.')}</p>
        <div class="cta__actions">
          <a href={tel ?? '/contacto'} class="btn btn--white">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            {tel ? clinica.telefono : 'Llámanos'}
          </a>
          <a href="/contacto" class="cta__link">o escríbenos un mensaje</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ==========================================
     Portada
     ========================================== */
  /* Nivel 3: la portada es la banda más tostada. A partir de aquí
     la página se va aclarando hasta el pie. */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--surface-tinted);
    border-bottom: 1px solid var(--color-border-light);
    /* Menos aire abajo: la sección siguiente ya trae el suyo */
    padding: var(--space-6) 0 var(--space-5);
    display: flex;
    align-items: center;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 55% 60% at 100% 0%, rgba(231, 127, 74, 0.16) 0%, transparent 70%);
  }

  .hero__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(184, 90, 40, 0.07) 1px, transparent 1px);
    background-size: 28px 28px;
    /* Se difumina hacia abajo para no cortar de golpe contra la sección siguiente */
    -webkit-mask-image: linear-gradient(to bottom, #000 25%, transparent 95%);
    mask-image: linear-gradient(to bottom, #000 25%, transparent 95%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-7);
    align-items: center;
  }

  .hero__title {
    font-size: var(--text-4xl);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 52ch;
    margin-bottom: var(--space-5);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  /* ==========================================
     Panel de horario
     ========================================== */
  .hero__panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius);
    padding: var(--space-4);
    box-shadow: var(--shadow-lg);
  }

  .hero__panel-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .hero__horario {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    padding: 0;
  }

  .hero__horario li {
    font-size: var(--text-base);
    color: var(--color-text);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-light);
  }

  .hero__horario li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .hero__mapa {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    /* Va dentro del panel blanco, así que el tinte suave sí contrasta aquí */
    background: var(--color-primary-tint);
    border: 1px solid var(--color-primary-tint-strong);
    color: var(--color-primary-dark);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: 1.4;
    transition: background var(--transition-fast);
  }

  .hero__mapa:hover {
    background: var(--color-primary-tint-strong);
  }

  .hero__mapa svg {
    flex-shrink: 0;
  }

  /* ==========================================
     Servicios
     ========================================== */
  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }

  .services__cta {
    text-align: center;
    margin-top: var(--space-5);
  }

  /* ==========================================
     Por qué nosotros
     ========================================== */
  /* Nivel 2: banda blanca. Contra la base solo hay un 1,3 % de diferencia
     de luminosidad, así que el filete no es decorativo: sin él no se ve. */
  .why {
    background: var(--surface-raised);
    border-top: 1px solid var(--color-border-light);
    border-bottom: 1px solid var(--color-border-light);
  }

  .why__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-3);
  }

  .why__card {
    padding: var(--space-4);
    border-radius: var(--radius);
    border: 1px solid var(--color-border-light);
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .why__card:hover {
    border-color: var(--color-primary-tint-strong);
    box-shadow: var(--shadow-md);
  }

  .why__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--color-primary-tint);
    color: var(--color-primary);
    border-radius: var(--radius);
    margin-bottom: var(--space-3);
  }

  .why__card h3 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .why__card p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  /* ==========================================
     Llamada final
     ========================================== */
  .cta {
    padding: var(--space-7) 0;
  }

  .cta__inner {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    border-radius: var(--radius);
    padding: var(--space-6) var(--space-4);
    text-align: center;
    color: #fff;
  }

  .cta__inner h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .cta__inner p {
    font-size: var(--text-lg);
    /* Blanco puro: al 90 % daba 3,72:1 sobre el extremo claro del degradado */
    color: #fff;
    margin: 0 auto var(--space-4);
    max-width: 48ch;
  }

  .cta__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .cta__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-2);
    font-size: var(--text-sm);
    /* Blanco puro: al 90 % daba 3,72:1 sobre el extremo claro del degradado */
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cta__link:hover {
    color: #fff;
  }

  /* ==========================================
     Adaptación a pantallas pequeñas
     ========================================== */
  @media (max-width: 880px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .hero {
      padding: var(--space-6) 0;
    }
  }

  @media (max-width: 480px) {
    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
