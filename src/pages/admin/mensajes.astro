---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../lib/supabase';
import { requireAdmin } from '../../lib/adminAuth';

const { user, redirect } = await requireAdmin(Astro);
if (redirect) return redirect;

// Borrar un mensaje
if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const accion = datos.get('accion');
  const id = datos.get('id') as string | null;

  if (accion === 'borrar' && id) {
    await supabase.from('contacto_mensajes').delete().eq('id', id);
  }

  return Astro.redirect('/admin/mensajes');
}

const { data: mensajes } = await supabase
  .from('contacto_mensajes')
  .select('*')
  .order('created_at', { ascending: false });

const formatearFechaHora = (fecha: string) =>
  new Date(fecha).toLocaleDateString('es-ES', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });

const total = mensajes?.length ?? 0;
---

<AdminLayout
  title="Mensajes de contacto"
  subtitle={total === 1 ? '1 mensaje recibido' : `${total} mensajes recibidos`}
  email={user.email ?? ''}
>
  {total > 0 ? (
    <div class="lista">
      {mensajes!.map((m: any) => (
        <article class="mensaje">
          <div class="mensaje__cabecera">
            <div>
              <h2>{m.nombre}</h2>
              <p class="mensaje__email"><a href={`mailto:${m.email}`}>{m.email}</a></p>
            </div>
            <time class="mensaje__fecha" datetime={m.created_at}>{formatearFechaHora(m.created_at)}</time>
          </div>

          {m.asunto && <p class="mensaje__asunto">{m.asunto}</p>}
          <p class="mensaje__texto">{m.mensaje}</p>

          <form method="POST" class="mensaje__acciones" data-confirmar>
            <input type="hidden" name="accion" value="borrar" />
            <input type="hidden" name="id" value={m.id} />
            <button type="submit" class="accion accion--peligro">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
              Borrar
            </button>
          </form>
        </article>
      ))}
    </div>
  ) : (
    <div class="panel">
      <p class="vacio">Todavía no ha llegado ningún mensaje</p>
    </div>
  )}
</AdminLayout>

<script>
  // Pedimos confirmación antes de borrar, que no tiene vuelta atrás
  document.querySelectorAll('form[data-confirmar]').forEach(formulario => {
    formulario.addEventListener('submit', evento => {
      if (!confirm('¿Seguro que quieres borrar este mensaje? No se puede recuperar.')) {
        evento.preventDefault();
      }
    });
  });
</script>

<style>
  .lista {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mensaje {
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius);
    padding: var(--space-3);
  }

  .mensaje__cabecera {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }

  .mensaje h2 {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }

  .mensaje__email {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .mensaje__email a:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .mensaje__fecha {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .mensaje__asunto {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-primary-dark);
    margin-bottom: var(--space-1);
  }

  .mensaje__texto {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    white-space: pre-wrap;
  }

  .mensaje__acciones {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border-light);
  }
</style>
