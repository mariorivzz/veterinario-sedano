---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../lib/supabase';
import { requireAdmin } from '../../lib/adminAuth';

const { user, redirect } = await requireAdmin(Astro);
if (redirect) return redirect;

let mensajeOk = '';
let mensajeError = '';

// Guardar los textos editados
if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const cambios: { clave: string; valor: string }[] = [];

  for (const [campo, valor] of datos.entries()) {
    if (campo.startsWith('contenido_')) {
      cambios.push({ clave: campo.replace('contenido_', ''), valor: String(valor) });
    }
  }

  if (cambios.length > 0) {
    for (const { clave, valor } of cambios) {
      const { error } = await supabase
        .from('contenidos')
        .update({ valor, updated_at: new Date().toISOString() })
        .eq('clave', clave);

      if (error) {
        mensajeError = `No se ha podido guardar "${clave}". Vuelve a intentarlo.`;
        break;
      }
    }

    if (!mensajeError) {
      mensajeOk = 'Cambios guardados. Ya se ven en la web.';
    }
  }
}

const { data: contenidos } = await supabase
  .from('contenidos')
  .select('*')
  .order('seccion')
  .order('clave');

const nombresSeccion: Record<string, string> = {
  hero: 'Portada',
  stats: 'Cifras',
  servicios: 'Servicios',
  why: 'Por qué elegirnos',
  cta: 'Llamada final',
  contacto: 'Contacto',
  general: 'General',
};

const secciones: Record<string, any[]> = {};
if (contenidos) {
  for (const item of contenidos) {
    (secciones[item.seccion] ??= []).push(item);
  }
}
---

<AdminLayout
  title="Textos de la web"
  subtitle="Cambia lo que se lee en las páginas públicas sin tocar código"
  email={user.email ?? ''}
>
  {mensajeOk && <p class="aviso aviso--ok" role="status">{mensajeOk}</p>}
  {mensajeError && <p class="aviso aviso--error" role="alert">{mensajeError}</p>}

  {contenidos && contenidos.length > 0 ? (
    <form method="POST">
      {Object.entries(secciones).map(([seccion, items]) => (
        <section class="grupo">
          <h2 class="grupo__titulo">{nombresSeccion[seccion] ?? seccion}</h2>
          <div class="grupo__campos">
            {items.map((item: any) => (
              <div class="form-field">
                <label for={`contenido_${item.clave}`}>{item.etiqueta}</label>
                {item.tipo === 'textarea' ? (
                  <textarea id={`contenido_${item.clave}`} name={`contenido_${item.clave}`} rows="3">{item.valor}</textarea>
                ) : (
                  <input type="text" id={`contenido_${item.clave}`} name={`contenido_${item.clave}`} value={item.valor} />
                )}
                <span class="clave">{item.clave}</span>
              </div>
            ))}
          </div>
        </section>
      ))}

      <div class="acciones">
        <button type="submit" class="btn btn--primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Guardar cambios
        </button>
      </div>
    </form>
  ) : (
    <div class="panel">
      <p class="vacio">
        Todavía no hay textos que editar. Ejecuta <code>supabase-contenidos.sql</code> en el editor SQL
        de Supabase para crear la tabla y sus valores iniciales.
      </p>
    </div>
  )}
</AdminLayout>

<style>
  .aviso {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }

  .aviso--ok {
    background: var(--color-success-soft);
    color: var(--color-success);
  }

  .aviso--error {
    background: var(--color-error-soft);
    color: var(--color-error);
  }

  .grupo {
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius);
    margin-bottom: var(--space-3);
    overflow: hidden;
  }

  .grupo__titulo {
    padding: var(--space-3);
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border-light);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
  }

  .grupo__campos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-3);
    padding: var(--space-3);
  }

  .clave {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-family: ui-monospace, 'Cascadia Mono', 'Consolas', monospace;
  }

  .acciones {
    position: sticky;
    bottom: 0;
    display: flex;
    justify-content: flex-end;
    padding: var(--space-3) 0;
    background: linear-gradient(to top, var(--color-background) 60%, transparent);
  }

  code {
    font-family: ui-monospace, 'Cascadia Mono', 'Consolas', monospace;
    font-size: 0.9em;
    background: var(--color-background);
    padding: 2px 6px;
    border-radius: var(--radius);
  }
</style>
