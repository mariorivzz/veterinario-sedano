---
import { clinica } from '../config/clinica';
import '../styles/global.css';

interface Props {
  title: string;
  subtitle?: string;
  email: string;
}

const { title, subtitle, email } = Astro.props;
const ruta = Astro.url.pathname;

const enlaces = [
  {
    href: '/admin',
    label: 'Panel principal',
    icono: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>',
  },
  {
    href: '/admin/mensajes',
    label: 'Mensajes',
    icono: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>',
  },
  {
    href: '/admin/contenidos',
    label: 'Contenidos',
    icono: '<path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>',
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <title>{title} | Panel de {clinica.nombre}</title>
  </head>
  <body>
    <div class="layout">
      <aside class="sidebar">
        <a href="/admin" class="sidebar__logo" aria-label={`${clinica.nombre} — panel`}>
          <img src="/logo.png" alt={clinica.nombre} width="500" height="417" />
        </a>

        <nav class="sidebar__nav" aria-label="Secciones del panel">
          {enlaces.map(enlace => (
            <a href={enlace.href} class:list={['sidebar__link', { active: ruta === enlace.href }]}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <Fragment set:html={enlace.icono} />
              </svg>
              {enlace.label}
            </a>
          ))}
          <a href="/" class="sidebar__link" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
            Ver la web
          </a>
        </nav>

        <div class="sidebar__footer">
          <p class="sidebar__user">{email}</p>
          <form method="POST" action="/admin/logout">
            <button type="submit" class="sidebar__logout">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
              Cerrar sesión
            </button>
          </form>
        </div>
      </aside>

      <main class="main">
        <header class="main__header">
          <h1>{title}</h1>
          {subtitle && <p>{subtitle}</p>}
        </header>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .layout {
    display: flex;
    min-height: 100vh;
  }

  /* ==========================================
     Barra lateral
     ========================================== */
  .sidebar {
    width: 260px;
    flex-shrink: 0;
    background: var(--color-surface);
    border-right: 1px solid var(--color-border-light);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
  }

  .sidebar__logo {
    display: flex;
    align-items: center;
    margin-bottom: var(--space-5);
    padding: 0 var(--space-2);
  }

  .sidebar__logo img {
    width: auto;
    height: 56px;
    mix-blend-mode: multiply;
  }

  .sidebar__nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .sidebar__link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    min-height: 44px;
    border-radius: var(--radius);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .sidebar__link:hover {
    background: var(--color-primary-tint);
    color: var(--color-text);
  }

  .sidebar__link.active {
    background: var(--color-primary-tint);
    color: var(--color-primary-dark);
    font-weight: var(--weight-semibold);
  }

  .sidebar__link svg {
    flex-shrink: 0;
  }

  .sidebar__footer {
    border-top: 1px solid var(--color-border-light);
    padding-top: var(--space-3);
  }

  .sidebar__user {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding: 0 var(--space-2);
    margin-bottom: var(--space-2);
    word-break: break-all;
  }

  .sidebar__logout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-2);
    min-height: 44px;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .sidebar__logout:hover {
    border-color: var(--color-error);
    color: var(--color-error);
  }

  /* ==========================================
     Zona principal
     ========================================== */
  .main {
    flex: 1;
    min-width: 0;
    padding: var(--space-5);
  }

  .main__header {
    margin-bottom: var(--space-5);
  }

  .main__header h1 {
    font-size: var(--text-2xl);
  }

  .main__header p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    margin-top: var(--space-1);
  }

  /* ==========================================
     En móvil la barra lateral pasa arriba.
     Antes desaparecía y dejaba el panel sin navegación.
     ========================================== */
  @media (max-width: 768px) {
    .layout {
      flex-direction: column;
    }

    .sidebar {
      width: 100%;
      height: auto;
      position: static;
      flex-direction: row;
      align-items: center;
      gap: var(--space-3);
      border-right: none;
      border-bottom: 1px solid var(--color-border-light);
      padding: var(--space-2) var(--space-3);
      overflow-x: auto;
    }

    .sidebar__logo {
      margin-bottom: 0;
      padding: 0;
      flex-shrink: 0;
    }

    .sidebar__nav {
      flex: 1;
      flex-direction: row;
      gap: var(--space-1);
    }

    .sidebar__link {
      white-space: nowrap;
    }

    .sidebar__footer {
      border-top: none;
      padding-top: 0;
      flex-shrink: 0;
    }

    .sidebar__user {
      display: none;
    }

    .main {
      padding: var(--space-3);
    }
  }

  @media (max-width: 560px) {
    .sidebar__link span,
    .sidebar__logout {
      font-size: var(--text-xs);
    }
  }
</style>

<style is:global>
  /* ==========================================
     Piezas compartidas por las páginas del panel
     ========================================== */
  .panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius);
    margin-bottom: var(--space-3);
    overflow: hidden;
  }

  .panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3);
    border-bottom: 1px solid var(--color-border-light);
  }

  .panel__header h2 {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }

  .panel__badge {
    background: var(--color-primary-tint);
    color: var(--color-primary-dark);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-round);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }

  /* Las tablas anchas se desplazan dentro de su caja, no estiran la página */
  .tabla-scroll {
    overflow-x: auto;
  }

  .panel table {
    width: 100%;
    border-collapse: collapse;
  }

  .panel th {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border-light);
    white-space: nowrap;
  }

  .panel td {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    border-bottom: 1px solid var(--color-border-light);
    vertical-align: top;
  }

  .panel tr:last-child td {
    border-bottom: none;
  }

  .panel tbody tr:hover td {
    background: var(--color-background);
  }

  .dato-secundario {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .vacio {
    text-align: center;
    padding: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .stat-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius);
    padding: var(--space-3);
  }

  .stat-card__label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .stat-card__value {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    margin-top: var(--space-1);
  }

  .stat-card__icon {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    width: 40px;
    height: 40px;
    background: var(--color-primary-tint);
    color: var(--color-primary);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .accion {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-2);
    min-height: 36px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-family: inherit;
    font-size: var(--text-xs);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .accion:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
  }

  .accion--peligro:hover {
    border-color: var(--color-error);
    color: var(--color-error);
  }
</style>
