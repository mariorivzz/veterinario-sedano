# Supabase — panel del proyecto: Settings > API
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# Groq — para el chatbot (/api/chat)
GROQ_API_KEY=gsk_tu_clave_de_groq

# Opcional: para cambiar de modelo sin tocar el código.
# Si no se pone, se usa openai/gpt-oss-120b.
# Modelos vivos: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b
