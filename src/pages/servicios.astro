---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { clinica, telefonoEnlace } from '../config/clinica';

const tel = telefonoEnlace();

const servicios = [
  {
    icon: 'stethoscope',
    title: 'Consulta general',
    description: 'Revisamos a tu mascota de arriba abajo, damos con lo que le pasa y te explicamos el tratamiento paso a paso.',
  },
  {
    icon: 'syringe',
    title: 'Vacunación',
    description: 'Le ponemos las vacunas que le tocan según su edad y llevamos la cuenta para que no se te pase ninguna.',
  },
  {
    icon: 'tooth',
    title: 'Odontología',
    description: 'Limpiezas de boca, extracciones y tratamiento de encías. Los dientes en mal estado duelen más de lo que parece.',
  },
  {
    icon: 'scissors',
    title: 'Peluquería',
    description: 'Baño, corte, cepillado y quitar el pelo muerto, adaptado al pelaje de cada animal.',
  },
  {
    icon: 'microscope',
    title: 'Análisis',
    description: 'Análisis de sangre y de orina hechos aquí mismo, para tener los resultados cuanto antes.',
  },
  {
    icon: 'hospital',
    title: 'Cirugía',
    description: 'Operaciones con anestesia vigilada en todo momento. Te contamos antes en qué consiste y qué esperar después.',
  },
  {
    icon: 'pill',
    title: 'Farmacia',
    description: 'Tenemos aquí los medicamentos y productos que le recetamos, para que no tengas que buscarlos fuera.',
  },
];
---

<Layout
  title="Servicios"
  description="Consulta, vacunas, odontología, peluquería, análisis y cirugía para tu mascota en Salamanca."
>
  <section class="page-hero">
    <div class="container">
      <span class="badge reveal">Nuestros servicios</span>
      <h1 class="reveal">Todo lo que tu mascota necesita</h1>
      <p class="reveal">Del día a día a lo más delicado, con el mismo cuidado y explicándotelo siempre claro.</p>
    </div>
  </section>

  <section class="services section">
    <div class="container">
      <div class="services__grid">
        {servicios.map(servicio => (
          <div class="reveal">
            <ServiceCard icon={servicio.icon} title={servicio.title} description={servicio.description} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-banner reveal">
    <div class="container">
      <div class="cta-banner__inner">
        <div class="cta-banner__text">
          <h2>¿No sabes qué necesita tu mascota?</h2>
          <p>Llámanos y lo vemos contigo, sin compromiso.</p>
        </div>
        <a href={tel ?? '/contacto'} class="btn btn--white cta-banner__btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          {tel ? clinica.telefono : 'Llámanos'}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Misma banda tostada que la portada: es el patrón de «cabecera de página» */
  .page-hero {
    padding: var(--space-7) 0 var(--space-5);
    text-align: center;
    background:
      radial-gradient(ellipse 60% 60% at 50% 0%, rgba(231, 127, 74, 0.14) 0%, transparent 70%),
      var(--surface-tinted);
    border-bottom: 1px solid var(--color-border-light);
  }

  .page-hero h1 {
    font-size: var(--text-3xl);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .page-hero p {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 56ch;
    margin: 0 auto;
  }

  .services {
    padding-top: var(--space-7);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }

  .cta-banner {
    padding: 0 0 var(--space-7);
  }

  .cta-banner__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    border-radius: var(--radius);
    padding: var(--space-6) var(--space-5);
    color: #fff;
  }

  .cta-banner h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-1);
  }

  .cta-banner p {
    /* Blanco puro: al 90 % daba 3,72:1 sobre el extremo claro del degradado */
    color: #fff;
    font-size: var(--text-sm);
  }

  .cta-banner__btn {
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .cta-banner__inner {
      flex-direction: column;
      text-align: center;
      padding: var(--space-5) var(--space-4);
    }
  }

  @media (max-width: 480px) {
    .cta-banner__btn {
      width: 100%;
    }
  }
</style>
